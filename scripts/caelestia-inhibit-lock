#!/usr/bin/env bash

# ==============================================================================
# caelestia-inhibit-lock
# Evita el bloqueo de pantalla por inactividad en Caelestia + Hyprland durante
# un tiempo determinado (por defecto 30 min).
# ==============================================================================

PID_FILE="/tmp/caelestia-inhibit-lock.pid"
INFO_FILE="/tmp/caelestia-inhibit-lock.info"
DEFAULT_TIME="30m"

# Colores para la salida en terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # Sin color

# Ayuda
show_help() {
    cat << 'EOF'
caelestia-inhibit-lock - Evita el bloqueo de pantalla por inactividad temporalmente.

USO:
  inhibit-lock [TIEMPO] [OPCIONES]
  caelestia-inhibit-lock [TIEMPO] [OPCIONES]

ARGUMENTOS DE TIEMPO:
  30           30 minutos (si no se especifica unidad, por defecto son minutos)
  30m          30 minutos
  1h           1 hora
  45s          45 segundos
  1h30m        1 hora y 30 minutos

OPCIONES:
  -b, --background  Ejecuta el inhibidor en segundo plano (daemon).
  -s, --status      Muestra el estado actual del inhibidor y el tiempo restante.
  -k, --stop, --off Detiene el inhibidor activo y reactiva el bloqueo automático.
  -t, --toggle [T]  Conmuta el inhibidor (si está activo lo apaga; si no, lo inicia por T min).
  -h, --help        Muestra esta ayuda.

EJEMPLOS:
  inhibit-lock             # Activa el inhibidor por 30 minutos en primer plano
  inhibit-lock 45m         # Activa el inhibidor por 45 minutos
  inhibit-lock 30m -b      # Activa el inhibidor por 30 minutos en segundo plano
  inhibit-lock 2h          # Activa el inhibidor por 2 horas
  inhibit-lock --status    # Revisa cuánto tiempo queda
  inhibit-lock --stop      # Reactiva el bloqueo inmediatamente
EOF
}

# Convertir cadena de tiempo a segundos totales
parse_time() {
    local input="$1"
    if [[ "$input" =~ ^[0-9]+$ ]]; then
        echo $(( input * 60 ))
        return 0
    fi
    local re="^(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?$"
    if [[ "$input" =~ $re ]]; then
        local hours="${BASH_REMATCH[2]:-0}"
        local mins="${BASH_REMATCH[4]:-0}"
        local secs="${BASH_REMATCH[6]:-0}"
        local total=$(( hours * 3600 + mins * 60 + secs ))
        if [ "$total" -gt 0 ]; then
            echo "$total"
            return 0
        fi
    fi
    echo "ERROR"
    return 1
}

# Formatear segundos a formato legible (ej. 1h 30m 15s)
format_time() {
    local secs=$1
    local h=$(( secs / 3600 ))
    local m=$(( (secs % 3600) / 60 ))
    local s=$(( secs % 60 ))
    local res=""
    [ $h -gt 0 ] && res="${h}h "
    [ $m -gt 0 ] && res="${res}${m}m "
    [ $s -gt 0 -o -z "$res" ] && res="${res}${s}s"
    echo "$res" | sed "s/ $//"
}

# Comprobar si hay un proceso corriendo
is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "$pid"
            return 0
        fi
    fi
    return 1
}

# Enviar notificación toast de Caelestia o notify-send
send_notification() {
    local type="$1"    # info, success, warn, error
    local title="$2"
    local message="$3"
    local icon="${4:-timer-symbolic}"

    if command -v caelestia >/dev/null 2>&1; then
        caelestia shell toaster "$type" "$title" "$message" "$icon" 2>/dev/null
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "$title" "$message" -i "$icon" 2>/dev/null
    fi
}

# Activar inhibidor de Caelestia
enable_inhibitor() {
    if command -v caelestia >/dev/null 2>&1; then
        caelestia shell idleInhibitor enable 2>/dev/null
    fi
}

# Desactivar inhibidor de Caelestia
disable_inhibitor() {
    if command -v caelestia >/dev/null 2>&1; then
        caelestia shell idleInhibitor disable 2>/dev/null
    fi
}

# Limpieza al salir
CLEANUP_DONE=0
cleanup() {
    [ "$CLEANUP_DONE" -eq 1 ] && return
    CLEANUP_DONE=1

    disable_inhibitor

    if [ -n "$SYSTEMD_INHIBIT_PID" ] && kill -0 "$SYSTEMD_INHIBIT_PID" 2>/dev/null; then
        kill "$SYSTEMD_INHIBIT_PID" 2>/dev/null
    fi

    rm -f "$PID_FILE" "$INFO_FILE" 2>/dev/null
    send_notification "info" "Inhibidor de Bloqueo" "El bloqueo automático por inactividad se ha reactivado." "lock-symbolic"
}

# Comando: Estado
cmd_status() {
    local pid
    if pid=$(is_running); then
        if [ -f "$INFO_FILE" ]; then
            source "$INFO_FILE" 2>/dev/null
            local now
            now=$(date +%s)
            local remaining=$(( END_TIME - now ))
            if [ $remaining -gt 0 ]; then
                local rem_str
                rem_str=$(format_time "$remaining")
                local dur_str
                dur_str=$(format_time "$DURATION")
                echo -e "${GREEN}● Inhibidor activo${NC} (PID: $pid)"
                echo -e "  Duración total: $dur_str"
                echo -e "  Tiempo restante: ${BOLD}$rem_str${NC}"
                return 0
            fi
        fi
        echo -e "${GREEN}● Inhibidor activo${NC} (PID: $pid)"
    else
        echo -e "${YELLOW}○ Inhibidor inactivo.${NC} El bloqueo automático está activado."
    fi
}

# Comando: Detener
cmd_stop() {
    local pid
    if pid=$(is_running); then
        kill -TERM "$pid" 2>/dev/null
        for _ in {1..20}; do
            if ! kill -0 "$pid" 2>/dev/null; then break; fi
            sleep 0.1
        done
        rm -f "$PID_FILE" "$INFO_FILE" 2>/dev/null
        disable_inhibitor
        echo -e "${GREEN}✓ Inhibidor detenido.${NC} El bloqueo automático ha sido reactivado."
    else
        disable_inhibitor
        rm -f "$PID_FILE" "$INFO_FILE" 2>/dev/null
        echo -e "${YELLOW}No hay ningún inhibidor activo.${NC}"
    fi
}

# Comando: Toggle
cmd_toggle() {
    local time_arg="${1:-$DEFAULT_TIME}"
    if is_running >/dev/null; then
        cmd_stop
    else
        start_inhibitor "$time_arg" "true"
    fi
}

# Iniciar inhibidor
start_inhibitor() {
    local time_arg="$1"
    local background="$2"

    local total_seconds
    total_seconds=$(parse_time "$time_arg")
    if [ "$total_seconds" = "ERROR" ]; then
        echo -e "${RED}Error: Formato de tiempo inválido '$time_arg'.${NC}"
        echo "Ejemplos válidos: 30, 30m, 1h, 45s, 1h30m"
        exit 1
    fi

    # Si se solicitó segundo plano, relanzar proceso desvinculado
    if [ "$background" = "true" ]; then
        INTERNAL_DAEMON=true nohup "$0" "$time_arg" --internal-daemon >/dev/null 2>&1 &
        local daemon_pid=$!
        local dur_fmt
        dur_fmt=$(format_time "$total_seconds")
        echo -e "${GREEN}✓ Inhibidor iniciado en segundo plano${NC} por ${BOLD}$dur_fmt${NC} (PID: $daemon_pid)."
        echo -e "  Para ver el estado: ${CYAN}inhibit-lock --status${NC}"
        echo -e "  Para cancelar:      ${CYAN}inhibit-lock --stop${NC}"
        exit 0
    fi

    # Detener inhibidor previo si existe
    local pid
    if pid=$(is_running); then
        cmd_stop >/dev/null 2>&1
    fi

    # Registrar PID e INFO
    local now
    now=$(date +%s)
    local end_time=$(( now + total_seconds ))
    echo "$$" > "$PID_FILE"
    echo "END_TIME=$end_time" > "$INFO_FILE"
    echo "DURATION=$total_seconds" >> "$INFO_FILE"

    # Capturar señales para restaurar el bloqueo al salir
    trap cleanup EXIT INT TERM HUP

    # Activar el inhibidor en Caelestia
    enable_inhibitor

    # Inhibidor secundario con systemd-inhibit si está disponible
    if command -v systemd-inhibit >/dev/null 2>&1; then
        systemd-inhibit --what=idle --who="caelestia-inhibit-lock" --why="Evitando bloqueo por inactividad" sleep "$total_seconds" >/dev/null 2>&1 &
        SYSTEMD_INHIBIT_PID=$!
    fi

    local dur_fmt
    dur_fmt=$(format_time "$total_seconds")

    send_notification "info" "Inhibidor de Bloqueo Activo" "El bloqueo de pantalla está pausado durante $dur_fmt." "timer-symbolic"

    if [ -t 1 ] && [ "$INTERNAL_DAEMON" != "true" ]; then
        echo -e "${GREEN}✓ Inhibidor de bloqueo de pantalla activado.${NC}"
        echo -e "  Duración: ${BOLD}$dur_fmt${NC}"
        echo -e "  Presiona ${YELLOW}Ctrl+C${NC} para cancelar y reactivar el bloqueo antes de tiempo.\n"

        while [ $(date +%s) -lt $end_time ]; do
            local current_now
            current_now=$(date +%s)
            local rem=$(( end_time - current_now ))
            if [ $rem -le 0 ]; then break; fi
            local rem_fmt
            rem_fmt=$(format_time "$rem")
            echo -ne "\r${CYAN}⏳ Tiempo restante: ${BOLD}${rem_fmt}${NC}\033[K"
            sleep 1
        done
        echo -e "\n${GREEN}✓ Tiempo finalizado. Reactivando el bloqueo por inactividad.${NC}"
    else
        local sleep_time=$(( end_time - $(date +%s) ))
        if [ $sleep_time -gt 0 ]; then
            sleep $sleep_time
        fi
    fi
}

# ==============================================================================
# PARSER DE ARGUMENTOS
# ==============================================================================

TIME_ARG=""
BACKGROUND=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -s|--status)
            cmd_status
            exit 0
            ;;
        -k|--stop|--off|cancel)
            cmd_stop
            exit 0
            ;;
        -t|--toggle)
            shift
            cmd_toggle "${1:-$DEFAULT_TIME}"
            exit 0
            ;;
        -b|--background)
            BACKGROUND=true
            shift
            ;;
        --internal-daemon)
            INTERNAL_DAEMON=true
            shift
            ;;
        *)
            if [ -z "$TIME_ARG" ]; then
                TIME_ARG="$1"
            fi
            shift
            ;;
    esac
done

if [ -z "$TIME_ARG" ]; then
    TIME_ARG="$DEFAULT_TIME"
fi

start_inhibitor "$TIME_ARG" "$BACKGROUND"
