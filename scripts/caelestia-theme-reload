#!/usr/bin/env sh

if ! command -v tmux >/dev/null 2>&1 || ! tmux list-sessions >/dev/null 2>&1; then
  exit 0
fi

tmux source-file "$HOME/.tmux.conf"

# Caelestia has already broadcast its official sequences.txt, including OSC
# 11. Foot applies its configured alpha to that colour. Keep tmux panes on the
# terminal default so the updated translucent background remains visible.
tmux set-option -g window-style default
tmux set-option -g window-active-style default

tmux list-panes -a -F '#{pane_id}' | while IFS= read -r pane_id; do
  tmux set-option -p -u -t "$pane_id" window-style 2>/dev/null || :
  tmux set-option -p -u -t "$pane_id" window-active-style 2>/dev/null || :
done

tmux list-clients -F '#{client_name}' |
  while IFS= read -r client_name; do
    tmux refresh-client -t "$client_name" 2>/dev/null || :
  done
